# Django Settings
SECRET_KEY=django-insecure-replace-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,nexa-scan.click

# Supabase Direct Database Connection (PostgreSQL)
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_DB_HOST=your-supabase-db-host.supabase.co
SUPABASE_DB_PORT=5432

# Supabase API client settings (optional)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Groq AI Service
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2
GROQ_MODEL=qwen/qwen3.8-27b
